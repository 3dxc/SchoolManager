# ═══════════════════════════════════════════════════════════════════════
#  SchoolManager — Variables d'Environnement (EXEMPLE)
#
#  INSTRUCTIONS :
#  1. Copiez ce fichier : cp .env.example .env
#  2. Remplissez TOUTES les valeurs sensibles dans votre .env
#  3. Ne committez JAMAIS le fichier .env (voir .gitignore)
# ═══════════════════════════════════════════════════════════════════════

# ── Sécurité Django ───────────────────────────────────────────────────
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-votre-cle-secrete-tres-longue-et-aleatoire

# ── Mode Debug (False en production ABSOLUMENT) ───────────────────────
DEBUG=True

# ── Hôtes autorisés (en production : votre domaine) ──────────────────
# Exemple : ALLOWED_HOSTS=schoolmanager.example.ml,www.schoolmanager.example.ml
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de Données ───────────────────────────────────────────────────
# Développement local : SQLite (par défaut, ne pas renseigner)
# Production PostgreSQL (recommandé) :
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:motdepasse@localhost:5432/schoolmanager_db

# ── Paramètres Email (pour notifications et bulletins) ───────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.ml
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@schoolmanager.ml
EMAIL_HOST_PASSWORD=votre-mot-de-passe-email

# ── Stockage Médias (photos élèves, logos établissements) ─────────────
MEDIA_ROOT=media/
MEDIA_URL=/media/

# ── Fichiers Statiques (CSS, JS, images) ─────────────────────────────
STATIC_ROOT=staticfiles/
STATIC_URL=/static/

# ── Paramètres Métier SchoolManager Mali ─────────────────────────────
# Frais de scolarité par défaut en FCFA
FRAIS_SCOLARITE_DEFAUT=150000

# Note maximale (barème malien sur 20)
NOTE_MAX=20

# Fuseau horaire de Bamako
TIME_ZONE=Africa/Abidjan

# ── Clé API (si intégration services externes) ────────────────────────
# API_KEY_GOOGLE_MAPS=votre-cle-api-google-maps

# ── Sécurité Production ───────────────────────────────────────────────
# (À décommenter en production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ═══════════════════════════════════════════════════════════════════════
# Pour utiliser ce .env dans Django, installer :
#   pip install python-decouple
# puis dans settings.py :
#   from decouple import config
#   SECRET_KEY = config('SECRET_KEY')
#   DEBUG = config('DEBUG', cast=bool, default=False)
# ═══════════════════════════════════════════════════════════════════════

